set isopath="/boot/isos"
export isopath

insmod regexp
insmod all_video

for isofile in $isopath/nixos-minimal-ssh-enabled*.iso; do
  if [ -e "$isofile" ]; then
    regexp --set=isoname "$isopath/(.*)" "$isofile"
    menuentry "$isoname (loopback.cfg) ->" "$isofile" {
      iso_path="$2"
      export iso_path
      search --set=root --file "$iso_path"
      _loopback loop "$iso_path"
      root=(loop)
      configfile /boot/grub/loopback.cfg
      loopback --delete loop
    }
  fi
done
